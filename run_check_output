#!/bin/bash
#SBATCH --job-name=check_output
#SBATCH --account=uso101
#SBATCH --partition=shared
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --time=07:00:00
#SBATCH --mem=64G
#SBATCH --output=check_output_out.%j
#SBATCH --error=check_output_err.%j
#SBATCH --mail-user=HsinYi.Chen@usm.edu
#SBATCH --mail-type=BEGIN,END,FAIL,TIME_LIMIT_90

export HDF5_USE_FILE_LOCKING=FALSE

module load cpu/0.17.3b
module load matlab/2022b/lefe4oq

# -batch runs the script/command non-interactively, no GUI, and
# automatically exits MATLAB when done (also exits with MATLAB's error
# code if something crashes, which shows up cleanly in your SLURM log).
# Do NOT include the .m extension in the command below.
matlab -batch "check_output" -logfile checkoutput.log
